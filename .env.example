# NODE_ENV is managed automatically by Next.js (dev => development, build/start => production).
# Do NOT set NODE_ENV in .env: overriding it during `next build` breaks the internal
# /_global-error prerender ("Invariant: Expected workStore to be initialized", see next.js #87719).
DATABASE_URL="postgresql://user:password@localhost:5432/morningstar?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email delivery (password reset, member invites, contact + customer-care) via Resend
# Create a key at https://resend.com/api-keys and add your verified sender to EMAIL_FROM.
# Without RESEND_API_KEY, submissions are persisted when the database is available and the API returns an error.
RESEND_API_KEY=""
EMAIL_FROM="Consecuencia <onboarding@resend.dev>"
# Destination inboxes (not secrets). Override only if routing must change.
INTEREST_INBOX="ak.consecuencia@gmail.com"
CUSTOMER_CARE_INBOX="customercare.consecuencia@outlook.com"

# Admin/operations access — comma-separated emails allowed to open the /ops console.
# Set this to your own sign-in email; the page and all /api/admin/* routes are gated on it server-side.
ADMIN_EMAILS="ak.consecuencia@gmail.com"

# Engineering Ingestion Pipeline
INGESTION_STORAGE_DIR="./.data/ingestion-storage"
INGESTION_MAX_FILE_SIZE_BYTES="209715200"
