# NODE_ENV is managed automatically by Next.js (dev => development, build/start => production).
# Do NOT set NODE_ENV in .env: overriding it during `next build` breaks the internal
# /_global-error prerender ("Invariant: Expected workStore to be initialized", see next.js #87719).
DATABASE_URL="postgresql://user:password@localhost:5432/morningstar?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Engineering Ingestion Pipeline
INGESTION_STORAGE_DIR="./.data/ingestion-storage"
INGESTION_MAX_FILE_SIZE_BYTES="209715200"
